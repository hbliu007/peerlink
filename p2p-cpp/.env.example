# PeerLink Environment Configuration
# Copy to .env and customize for your native deployment.
# Official delivery path: SDK + Demo for clients, native binaries for servers.

# Optional unified config file. When set, TOML values are loaded first and the
# env vars below override them.
PEERLINK_CONFIG=

# ── Gateway (Signaling + DID) ──
SIGNALING_HOST=0.0.0.0
SIGNALING_PORT=8080
HEARTBEAT_INTERVAL=30
CONNECTION_TIMEOUT=90
# Keep this false in production. Set true only for local/dev bootstrap.
SIGNALING_ALLOW_INSECURE_REGISTRATION=false

DID_HOST=0.0.0.0
DID_PORT=8081
JWT_SECRET=change-me-in-production

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
LOG_LEVEL=info
GATEWAY_ADMIN_ENABLED=true
GATEWAY_ADMIN_HOST=127.0.0.1
GATEWAY_ADMIN_PORT=9300

# ── Network (STUN + TURN) ──
STUN_HOST=0.0.0.0
STUN_UDP_PORT=3478
STUN_TCP_PORT=3479

TURN_HOST=0.0.0.0
TURN_PORT=9001
TURN_PUBLIC_IP=<YOUR_SERVER_IP>
TURN_MIN_PORT=50000
TURN_MAX_PORT=50100
TURN_LIFETIME=600
TURN_MAX_ALLOCS=100
NETWORK_METRICS_INTERVAL_SECONDS=30
NETWORK_ADMIN_ENABLED=true
NETWORK_ADMIN_HOST=127.0.0.1
NETWORK_ADMIN_PORT=9301

# ── Standalone Service Admin Ports (optional) ──
SIGNALING_ADMIN_ENABLED=true
SIGNALING_ADMIN_HOST=127.0.0.1
SIGNALING_ADMIN_PORT=9302

DID_ADMIN_ENABLED=true
DID_ADMIN_HOST=127.0.0.1
DID_ADMIN_PORT=9303
